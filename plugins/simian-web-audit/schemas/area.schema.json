{
  "type": "object",
  "required": [
    "area",
    "findings",
    "checks"
  ],
  "properties": {
    "area": {
      "type": "string",
      "enum": [
        "ux",
        "a11y",
        "visual",
        "tech",
        "seo"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "now",
          "fix",
          "why",
          "impact",
          "effort",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "now": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort": {
            "type": "string",
            "enum": [
              "Bajo",
              "Medio",
              "Alto"
            ]
          },
          "headline_metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "technical_note": {
            "type": "string"
          },
          "pin": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "screenshot",
              "x_pct",
              "y_pct"
            ],
            "properties": {
              "screenshot": {
                "type": "string"
              },
              "x_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "partial",
              "fail",
              "na"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}